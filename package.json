{
  "name": "ap-exam-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:fetch": "NODE_USE_ENV_PROXY=1 node scripts/fetch-pdfs.mjs",
    "data:answers": "node scripts/extract-answers.mjs",
    "data:pages": "node scripts/render-pages.mjs",
    "data:build": "node scripts/build-exam.mjs",
    "data:figures": "python3 scripts/crop_figures.py",
    "data:validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
